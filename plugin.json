{
  "id": "qwenpaw-image-gen",
  "name": "ComfyUI 生图助手",
  "version": "1.0.9",
  "type": "general",
  "description": "面向 QwenPaw 的本地 ComfyUI 图像创作助手：自动适配模型与放大资源、生成任务、图库管理和参数复用。",
  "author": "QwenPaw Image Gen Contributors",
  "entry": {
    "backend": "backend/plugin.py",
    "frontend": "ui/index.1.0.9.js"
  },
  "dependencies": [
    "pillow>=10.0.0",
    "requests>=2.28.0"
  ],
  "qwenpaw_version": {
    "min": "2.0.1"
  },
  "min_version": "2.0.1",
  "description_i18n": {
    "zh-CN": "面向 QwenPaw 的本地 ComfyUI 图像创作助手：自动适配模型与放大资源、生成任务、图库管理和参数复用。",
    "en-US": "A local-first QwenPaw ComfyUI image-generation assistant with model/LoRA scanning, workflow presets, saved parameters, gallery ratings, and Artifact Library integration."
  },
  "meta": {
    "category": "creativity",
    "features": [
      "comfyui-bridge",
      "model-lora-scan",
      "workflow-presets",
      "save-workflow-parameters",
      "generated-image-gallery",
      "ratings-and-notes",
      "artifact-library-integration",
      "local-first-privacy",
      "community-safe-examples",
      "no-personal-workspace-paths",
      "desktop-cache-busting",
      "frontend-backend-version-check",
      "no-cache-api-headers",
      "deterministic-comfy-adapter",
      "full-resource-scan",
      "dynamic-sampler-scheduler",
      "anima-qwen-workflow",
      "workflow-bind-validation",
      "auto-workflow-bind",
      "async-generation-tasks",
      "batch-progress",
      "generation-review-settings",
      "recreate-and-variants"
    ]
  }
}
