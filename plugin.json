{
  "id": "qwenpaw-image-gen",
  "name": "生图助手",
  "version": "0.9.3",
  "type": "general",
  "description": "本地 ComfyUI 生图可视化助手：确定性模型识别、完整资源扫描、Anima 工作流适配、参数保存、图库评分与产物库联动。",
  "author": "QwenPaw Image Gen Contributors",
  "entry": {
    "backend": "backend/plugin.py",
    "frontend": "ui/index.0.9.3.js"
  },
  "dependencies": [
    "pillow>=10.0.0",
    "requests>=2.28.0"
  ],
  "qwenpaw_version": {
    "min": "2.0.1"
  },
  "description_i18n": {
    "zh-CN": "本地 ComfyUI 生图可视化助手：模型与 LoRA 扫描、默认工作流切换、参数保存、图库评分、产物库联动归档。",
    "en-US": "A local-first QwenPaw ComfyUI image-generation assistant with model/LoRA scanning, workflow presets, saved parameters, gallery ratings, and Artifact Library integration."
  },
  "meta": {
    "category": "creativity",
    "features": [
      "comfyui-bridge",
      "model-lora-scan",
      "workflow-presets",
      "save-workflow-parameters",
      "generated-image-gallery",
      "ratings-and-notes",
      "artifact-library-integration",
      "local-first-privacy",
      "community-safe-examples",
      "no-personal-workspace-paths",
      "desktop-cache-busting",
      "frontend-backend-version-check",
      "no-cache-api-headers",
      "deterministic-comfy-adapter",
      "full-resource-scan",
      "dynamic-sampler-scheduler",
      "anima-qwen-workflow",
      "workflow-bind-validation",
      "auto-workflow-bind"
    ]
  }
}
